# Database (Neon PostgreSQL)
# Required in production: Neon PostgreSQL connection string
# Example: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=

# Authentication Credentials (Private 2-Person App)
# Required in production: Set secure passwords for Mahesh and Her
ADMIN_PASSWORD=
GIRLFRIEND_PASSWORD=

# Application Customization (Optional)
NEXT_PUBLIC_APP_NAME="Our Little Reward Shop"
NEXT_PUBLIC_GIRLFRIEND_NAME="Her"
NEXT_PUBLIC_MAHESH_NAME="Mahesh"
